<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MentalHelp – Recovery Companion</title>
<style>
  :root {
    --bg:#0d0f14;--bg-card:#141720;--bg-card2:#1a1e2a;--bg-input:#1e2232;
    --accent:#6c63ff;--accent2:#9d8fff;--accent-muted:rgba(108,99,255,0.15);
    --text:#e8eaf0;--text-muted:#7a8099;--text-dim:#4a5270;
    --border:rgba(255,255,255,0.07);--border2:rgba(108,99,255,0.3);
    --success:#4ade80;--warn:#fbbf24;--danger:#f87171;
    --radius:16px;--radius-sm:10px;--radius-pill:999px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{background:var(--bg);color:var(--text);font-family:-apple-system,BlinkMacSystemFont,'SF Pro Display','Segoe UI',sans-serif;min-height:100vh;font-size:15px;line-height:1.6;-webkit-font-smoothing:antialiased}
  #app{max-width:440px;margin:0 auto;min-height:100vh;position:relative}
  .screen{display:none;padding:24px 20px 100px}
  .screen.active{display:block}

  /* NAV */
  .nav{position:fixed;bottom:0;left:50%;transform:translateX(-50%);width:100%;max-width:440px;background:rgba(13,15,20,0.92);backdrop-filter:blur(16px);border-top:1px solid var(--border);display:flex;justify-content:space-around;align-items:center;padding:10px 0 20px;z-index:100}
  .nav-btn{display:flex;flex-direction:column;align-items:center;gap:3px;background:none;border:none;color:var(--text-dim);cursor:pointer;font-size:10px;letter-spacing:0.04em;text-transform:uppercase;transition:color 0.2s;padding:4px 12px;border-radius:var(--radius-sm)}
  .nav-btn svg{width:22px;height:22px}
  .nav-btn.active{color:var(--accent2)}

  /* CARDS */
  .card{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius);padding:20px;margin-bottom:14px}
  .card-dark{background:var(--bg-card2);border:1px solid var(--border);border-radius:var(--radius);padding:20px;margin-bottom:14px}
  .card-accent{background:linear-gradient(135deg,rgba(108,99,255,0.18) 0%,rgba(74,62,200,0.08) 100%);border:1px solid var(--border2);border-radius:var(--radius);padding:20px;margin-bottom:14px}

  /* TYPE */
  .h1{font-size:26px;font-weight:700;letter-spacing:-0.5px;line-height:1.2}
  .h2{font-size:19px;font-weight:600;letter-spacing:-0.3px}
  .h3{font-size:15px;font-weight:600}
  .label{font-size:11px;font-weight:600;letter-spacing:0.08em;text-transform:uppercase;color:var(--text-muted)}
  .muted{color:var(--text-muted)}
  .small{font-size:13px}

  /* BUTTONS */
  .btn{display:block;width:100%;padding:14px 20px;background:var(--accent);color:#fff;border:none;border-radius:var(--radius-sm);font-size:15px;font-weight:600;cursor:pointer;transition:opacity .2s,transform .1s;letter-spacing:-0.2px}
  .btn:hover{opacity:.9}
  .btn:active{transform:scale(.98)}
  .btn-ghost{background:transparent;border:1px solid var(--border2);color:var(--accent2)}
  .btn-ghost:hover{background:var(--accent-muted)}
  .btn-danger-ghost{background:transparent;border:1px solid rgba(248,113,113,0.3);color:var(--danger)}
  .btn-sm{padding:9px 16px;font-size:13px;width:auto;display:inline-block}

  /* CHIPS */
  .chip-group{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
  .chip{padding:8px 14px;border-radius:var(--radius-pill);border:1px solid var(--border);background:var(--bg-input);color:var(--text-muted);font-size:13px;cursor:pointer;transition:all .15s;user-select:none}
  .chip:hover{border-color:var(--accent2);color:var(--text)}
  .chip.selected{background:var(--accent-muted);border-color:var(--accent2);color:var(--accent2);font-weight:500}

  /* RANGE */
  input[type=range]{width:100%;-webkit-appearance:none;appearance:none;height:4px;background:var(--border);border-radius:2px;outline:none}
  input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;appearance:none;width:22px;height:22px;background:var(--accent);border-radius:50%;cursor:pointer;box-shadow:0 0 0 4px rgba(108,99,255,0.2)}
  .range-labels{display:flex;justify-content:space-between;margin-top:6px}

  /* STEP */
  .step-dot-row{display:flex;gap:6px;margin-bottom:24px}
  .step-dot{height:3px;border-radius:2px;background:var(--border);flex:1;transition:background .3s}
  .step-dot.done{background:var(--accent)}
  .step-dot.active{background:var(--accent2)}

  /* STREAK */
  .streak-circle{width:110px;height:110px;border-radius:50%;background:conic-gradient(var(--accent) var(--p,0%),var(--bg-card2) 0%);display:flex;align-items:center;justify-content:center}
  .streak-inner{width:88px;height:88px;border-radius:50%;background:var(--bg-card);display:flex;flex-direction:column;align-items:center;justify-content:center}

  /* CHART */
  .chart-bars{display:flex;align-items:flex-end;gap:6px;height:70px;margin-top:12px}
  .bar-col{flex:1;display:flex;flex-direction:column;align-items:center;gap:4px}
  .bar{width:100%;border-radius:4px 4px 0 0;background:var(--accent-muted);border:1px solid rgba(108,99,255,0.2);min-height:4px;transition:height .5s}
  .bar.high{background:rgba(248,113,113,0.25);border-color:rgba(248,113,113,0.3)}
  .bar.low{background:rgba(74,222,128,0.2);border-color:rgba(74,222,128,0.25)}
  .bar-label{font-size:10px;color:var(--text-dim)}

  /* AUDIO CARD */
  .audio-card{border-radius:var(--radius);border:1px solid var(--border2);padding:18px 20px;margin-bottom:12px;position:relative;overflow:hidden}
  .audio-card::before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,rgba(108,99,255,0.1) 0%,transparent 60%);pointer-events:none}
  .audio-card.emergency{border-color:rgba(248,113,113,0.4)}
  .audio-card.emergency::before{background:linear-gradient(135deg,rgba(248,113,113,0.1) 0%,transparent 60%)}
  .session-tag{display:inline-block;padding:3px 10px;border-radius:var(--radius-pill);font-size:11px;font-weight:600;letter-spacing:0.05em;background:var(--accent-muted);color:var(--accent2);margin-bottom:10px}
  .session-tag.em{background:rgba(248,113,113,0.15);color:var(--danger)}

  /* PLAYER */
  .player-wrap{background:var(--bg-input);border:1px solid var(--border);border-radius:var(--radius-sm);overflow:hidden;margin-top:12px;position:relative}
  .player-wrap iframe{display:block;width:100%;height:200px;border:none}
  .player-overlay{position:absolute;top:0;left:0;right:0;bottom:0;background:rgba(13,15,20,0.6);display:flex;align-items:center;justify-content:center;cursor:pointer;transition:opacity .2s}
  .player-overlay.hidden-overlay{display:none}
  .player-overlay .play-icon{width:60px;height:60px;background:var(--accent);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:22px}
  .player-controls{display:flex;align-items:center;gap:10px;padding:12px}
  .play-btn-sm{width:40px;height:40px;border-radius:50%;background:var(--accent);border:none;color:#fff;font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;flex-shrink:0}
  .player-info{flex:1;min-width:0}
  .player-title{font-size:13px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  .player-status{font-size:11px;color:var(--text-muted);margin-top:2px}
  .waveform{display:flex;align-items:center;gap:2px;height:24px}
  .wave-bar{width:3px;border-radius:2px;background:var(--accent);animation:wave 1s infinite;min-height:4px}
  .wave-bar:nth-child(2){animation-delay:.1s}
  .wave-bar:nth-child(3){animation-delay:.2s}
  .wave-bar:nth-child(4){animation-delay:.15s}
  .wave-bar:nth-child(5){animation-delay:.05s}
  @keyframes wave{0%,100%{height:4px}50%{height:20px}}
  .waveform.paused .wave-bar{animation:none;height:8px}

  /* MINI PLAYER */
  #mini-player{position:fixed;bottom:70px;left:50%;transform:translateX(-50%);width:calc(100% - 24px);max-width:416px;background:var(--bg-card);border:1px solid var(--border2);border-radius:var(--radius-sm);padding:10px 14px;display:none;align-items:center;gap:10px;z-index:90;box-shadow:0 4px 20px rgba(0,0,0,0.4)}
  #mini-player.visible{display:flex}
  #mini-icon{font-size:20px;flex-shrink:0}
  #mini-info{flex:1;min-width:0}
  #mini-title{font-size:12px;font-weight:600;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
  #mini-status{font-size:10px;color:var(--text-muted)}
  #mini-play{width:32px;height:32px;border-radius:50%;background:var(--accent);border:none;color:#fff;font-size:14px;cursor:pointer;flex-shrink:0;display:flex;align-items:center;justify-content:center}
  #mini-stop{width:32px;height:32px;border-radius:50%;background:transparent;border:1px solid var(--border);color:var(--text-muted);font-size:12px;cursor:pointer;flex-shrink:0;display:flex;align-items:center;justify-content:center}

  /* HIDDEN PLAYER CONTAINER */
  #yt-container{position:fixed;bottom:-300px;left:-9999px;width:320px;height:180px;opacity:0;pointer-events:none}
  #yt-container iframe{width:100%;height:100%;border:none}

  /* QUOTE */
  .quote-card{border-left:3px solid var(--accent);padding:14px 16px;background:var(--bg-card2);border-radius:0 var(--radius-sm) var(--radius-sm) 0;margin-bottom:14px}
  .quote-card p{font-style:italic;font-size:14px;color:var(--text);line-height:1.7}
  .quote-card .attr{font-size:12px;color:var(--text-dim);margin-top:6px;font-style:normal}

  /* COACH BUBBLE */
  .coach-bubble{background:var(--bg-card2);border:1px solid var(--border2);border-radius:4px var(--radius) var(--radius) var(--radius);padding:16px;margin-bottom:14px}

  /* STATS */
  .stats-grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px}
  .stat-box{background:var(--bg-card);border:1px solid var(--border);border-radius:var(--radius-sm);padding:14px}
  .stat-val{font-size:24px;font-weight:700;letter-spacing:-0.5px}
  .stat-label{font-size:11px;color:var(--text-muted);margin-top:2px}

  /* MISC */
  .sec-header{margin:28px 0 12px}
  .relapse-step{display:flex;gap:14px;align-items:flex-start;padding:14px 0;border-bottom:1px solid var(--border)}
  .relapse-step:last-child{border-bottom:none}
  .step-num{width:28px;height:28px;border-radius:50%;background:var(--accent-muted);border:1px solid var(--border2);display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;color:var(--accent2);flex-shrink:0}
  textarea{width:100%;background:var(--bg-input);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text);padding:12px;font-size:14px;resize:none;outline:none;font-family:inherit;transition:border-color .2s}
  textarea:focus{border-color:var(--border2)}
  .page-header{padding:20px 0 6px}
  .greeting{font-size:13px;color:var(--text-muted);margin-bottom:4px}
  .notif{position:fixed;top:20px;left:50%;transform:translateX(-50%);background:var(--bg-card);border:1px solid var(--border2);border-radius:var(--radius-sm);padding:12px 20px;font-size:14px;color:var(--text);z-index:999;opacity:0;transition:opacity .3s;max-width:360px;width:90%;text-align:center}
  .notif.show{opacity:1}
  .insight-box{background:rgba(108,99,255,0.08);border:1px solid rgba(108,99,255,0.25);border-radius:var(--radius-sm);padding:14px;margin-bottom:14px}
  .insight-box .label{color:var(--accent2);margin-bottom:6px}
  .dots span{display:inline-block;width:6px;height:6px;background:var(--accent2);border-radius:50%;margin:0 2px;animation:bounce 1.2s infinite}
  .dots span:nth-child(2){animation-delay:.2s}
  .dots span:nth-child(3){animation-delay:.4s}
  @keyframes bounce{0%,80%,100%{transform:translateY(0)}40%{transform:translateY(-5px)}}
  .fade-in{animation:fadeIn .4s ease}
  @keyframes fadeIn{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}
  .badge{display:inline-block;padding:2px 10px;border-radius:var(--radius-pill);font-size:11px;font-weight:600}
  .badge-green{background:rgba(74,222,128,0.15);color:var(--success)}
  .badge-warn{background:rgba(251,191,36,0.15);color:var(--warn)}
  .badge-danger{background:rgba(248,113,113,0.15);color:var(--danger)}
  .badge-purple{background:var(--accent-muted);color:var(--accent2)}
  .hidden{display:none!important}
  .mt-8{margin-top:8px}.mt-12{margin-top:12px}.mt-16{margin-top:16px}.mt-20{margin-top:20px}
  .mb-4{margin-bottom:4px}.mb-8{margin-bottom:8px}.mb-12{margin-bottom:12px}
  .flex{display:flex}.items-center{align-items:center}.justify-between{justify-content:space-between}
  .gap-8{gap:8px}.gap-12{gap:12px}

  /* ONBOARDING */
  .onboard-screen{min-height:100vh;display:flex;flex-direction:column;justify-content:center;align-items:center;padding:40px 24px;text-align:center}

  /* BRANDING */
  .brand-logo{display:flex;align-items:center;gap:10px;justify-content:center;margin-bottom:8px}
  .brand-mark{width:48px;height:48px;border-radius:16px;background:linear-gradient(135deg,#6c63ff,#9d8fff);display:flex;align-items:center;justify-content:center;font-size:22px;box-shadow:0 0 24px rgba(108,99,255,0.4)}
  .brand-name{font-size:26px;font-weight:800;letter-spacing:-1px;background:linear-gradient(135deg,#fff 30%,#9d8fff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
  .brand-tagline{font-size:12px;color:var(--text-muted);letter-spacing:0.1em;text-transform:uppercase;margin-bottom:28px}
  .brand-sm{display:flex;align-items:center;gap:6px}
  .brand-sm .mark{width:28px;height:28px;border-radius:9px;background:linear-gradient(135deg,#6c63ff,#9d8fff);display:flex;align-items:center;justify-content:center;font-size:13px}
  .brand-sm .name{font-size:15px;font-weight:700;letter-spacing:-0.5px;background:linear-gradient(135deg,#fff 30%,#9d8fff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text}
</style>
</head>
<body>
<div id="app">
  <div class="notif" id="notif"></div>

  <!-- Hidden YT container -->
  <div id="yt-container"></div>

  <!-- Mini Player -->
  <div id="mini-player">
    <div id="mini-icon">🎵</div>
    <div id="mini-info">
      <div id="mini-title">—</div>
      <div id="mini-status">Sedang diputar</div>
    </div>
    <button id="mini-play" onclick="toggleMiniPlay()">⏸</button>
    <button id="mini-stop" onclick="stopSession()">■</button>
  </div>

  <!-- ONBOARDING -->
  <div id="onboard" class="hidden">
    <div class="onboard-screen">
      <div class="brand-logo">
        <div class="brand-mark">🧠</div>
        <div class="brand-name">MentalHelp</div>
      </div>
      <div class="brand-tagline">Recovery Companion</div>
      <p class="muted small" style="max-width:280px;line-height:1.7;margin-bottom:36px">
        Perjalanan pemulihan dimulai dari memahami diri sendiri. Kami hadir menemani setiap langkahnya.
      </p>
      <button class="btn" onclick="startApp()" style="max-width:280px">Mulai perjalanan saya →</button>
      <p class="small muted" style="margin-top:16px;font-size:11px">Privat & aman. Data tersimpan hanya di perangkat Anda.</p>
    </div>
  </div>

  <!-- MAIN APP -->
  <div id="main-app" class="hidden">

    <!-- HOME -->
    <div id="screen-home" class="screen active">
      <div class="page-header">
        <div class="brand-sm mb-8">
          <div class="mark">🧠</div>
          <div class="name">MentalHelp</div>
        </div>
        <p class="greeting" id="greeting-text">Selamat pagi</p>
        <h1 class="h1">Bagaimana kondisi<br>Anda hari ini?</h1>
      </div>

      <div class="card mt-20" style="display:flex;align-items:center;gap:20px">
        <div class="streak-circle" id="streak-circle">
          <div class="streak-inner">
            <span style="font-size:26px;font-weight:700;letter-spacing:-1px" id="streak-days">0</span>
            <span style="font-size:11px;color:var(--text-muted)">hari</span>
          </div>
        </div>
        <div style="flex:1">
          <div class="label mb-4">Streak Pemulihan</div>
          <p id="streak-msg" class="small muted" style="line-height:1.5"></p>
          <div class="mt-8"><span class="badge badge-purple" id="streak-badge">Aktif</span></div>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-bottom:14px">
        <button class="card" style="text-align:left;cursor:pointer;border:none;background:var(--bg-card)" onclick="goCheckin()">
          <div style="font-size:22px;margin-bottom:8px">✦</div>
          <div class="h3 mb-4">Check-in Harian</div>
          <p class="small muted">Kenali kondisi & pemicu Anda</p>
        </button>
        <button class="card" style="text-align:left;cursor:pointer;border:none;background:var(--bg-card)" onclick="goRelapse()">
          <div style="font-size:22px;margin-bottom:8px">🛡</div>
          <div class="h3 mb-4">Baru Relapse?</div>
          <p class="small muted">Bangkit tanpa rasa malu</p>
        </button>
      </div>

      <div id="home-quote"></div>

      <div class="sec-header"><div class="label">Minggu Ini</div></div>
      <div class="stats-grid">
        <div class="stat-box"><div class="stat-val" id="stat-checkins">0</div><div class="stat-label">Check-in dilakukan</div></div>
        <div class="stat-box"><div class="stat-val" id="stat-avg-urge">—</div><div class="stat-label">Rata-rata dorongan</div></div>
        <div class="stat-box"><div class="stat-val" id="stat-top-trigger">—</div><div class="stat-label">Pemicu utama</div></div>
        <div class="stat-box"><div class="stat-val" id="stat-stability">—</div><div class="stat-label">Stabilitas emosi</div></div>
      </div>

      <div class="card">
        <div class="flex justify-between items-center mb-12">
          <div><div class="label mb-4">Tren Dorongan</div><p class="small muted">7 hari terakhir</p></div>
          <div class="badge badge-purple" id="trend-badge">—</div>
        </div>
        <div class="chart-bars" id="urge-chart"></div>
      </div>
    </div>

    <!-- CHECK-IN -->
    <div id="screen-checkin" class="screen">
      <div class="page-header">
        <p class="label mb-8">Trigger Discovery Worksheet</p>
        <h1 class="h1">Mari kenali<br>kondisi Anda</h1>
      </div>
      <div id="checkin-flow">
        <div class="step-dot-row mt-20" id="step-dots">
          <div class="step-dot active" id="dot-0"></div>
          <div class="step-dot" id="dot-1"></div>
          <div class="step-dot" id="dot-2"></div>
          <div class="step-dot" id="dot-3"></div>
        </div>
        <div id="step-0" class="fade-in">
          <p class="h3 mb-4">Apa yang Anda rasakan saat ini?</p>
          <p class="small muted mb-12">Pilih semua yang relevan</p>
          <div class="chip-group" id="chips-feeling">
            <div class="chip" data-val="Kesepian">Kesepian</div><div class="chip" data-val="Bosan">Bosan</div>
            <div class="chip" data-val="Cemas">Cemas</div><div class="chip" data-val="Stres">Stres</div>
            <div class="chip" data-val="Marah">Marah</div><div class="chip" data-val="Sedih">Sedih</div>
            <div class="chip" data-val="Kecewa">Kecewa</div><div class="chip" data-val="Tidak berharga">Tidak berharga</div>
            <div class="chip" data-val="Frustrasi">Frustrasi</div><div class="chip" data-val="Kosong">Kosong</div>
            <div class="chip" data-val="Lainnya">Lainnya</div>
          </div>
          <button class="btn mt-20" onclick="nextStep()">Lanjut →</button>
        </div>
        <div id="step-1" class="hidden fade-in">
          <p class="h3 mb-4">Apa yang terjadi sebelum dorongan muncul?</p>
          <p class="small muted mb-12">Pilih semua yang relevan</p>
          <div class="chip-group" id="chips-trigger">
            <div class="chip" data-val="Sendirian">Sendirian</div>
            <div class="chip" data-val="Scroll media sosial">Scroll media sosial</div>
            <div class="chip" data-val="Konflik pasangan">Konflik pasangan</div>
            <div class="chip" data-val="Konflik keluarga">Konflik keluarga</div>
            <div class="chip" data-val="Stres pekerjaan">Stres pekerjaan</div>
            <div class="chip" data-val="Sulit tidur">Sulit tidur</div>
            <div class="chip" data-val="Konten seksual">Melihat konten seksual</div>
            <div class="chip" data-val="Tidak ada aktivitas">Tidak ada aktivitas</div>
            <div class="chip" data-val="Baru bangun tidur">Baru bangun tidur</div>
            <div class="chip" data-val="Lainnya">Lainnya</div>
          </div>
          <div style="display:flex;gap:10px;margin-top:20px">
            <button class="btn btn-ghost" style="flex:0.4" onclick="prevStep()">← Kembali</button>
            <button class="btn" style="flex:1" onclick="nextStep()">Lanjut →</button>
          </div>
        </div>
        <div id="step-2" class="hidden fade-in">
          <p class="h3 mb-4">Seberapa kuat dorongan saat ini?</p>
          <p class="small muted mb-12">Geser untuk menunjukkan intensitasnya</p>
          <div class="card-dark">
            <div class="flex justify-between items-center mb-12">
