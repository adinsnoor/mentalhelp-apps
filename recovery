<script>
// =============================================
// AUDIO SOURCE — obfuscated, not displayed to user
// =============================================
const _amap = (function(){
  const b = 'aHR0cHM6Ly93d3cueW91dHViZS5jb20vZW1iZWQv';
  const ids = [
    'clAyNVFqTDJsNA==',
    'cDFpUWEwQUQ5b1E=',
    'SElwSE9WRUJLWXc=',
    'Q1MtVDJJR3BPbzA=',
    'RFJ2eDdQalFGZzQ=',
    'dkpLX094LS00czA='
  ];
  return ids.map(id => atob(b) + atob(id) + '?autoplay=1&enablejsapi=1&rel=0&modestbranding=1');
})();

// =============================================
// STATE
// =============================================
const STORE_KEY = 'mh_rc_v2';
function loadState(){try{const r=localStorage.getItem(STORE_KEY);if(r)return JSON.parse(r)}catch(e){}return{streak:0,streakStart:null,longestStreak:0,totalCheckins:0,checkins:[],lastCheckinDate:null,relapses:0}}
function saveState(){try{localStorage.setItem(STORE_KEY,JSON.stringify(state))}catch(e){}}
let state = loadState();

// =============================================
// PLAYER STATE
// =============================================
let currentSession = null;
let isPlaying = false;
let ytIframe = null;

function loadSession(sessionId) {
  const s = SESSIONS.find(x => x.id === sessionId);
  if (!s) return;
  
  currentSession = s;
  isPlaying = true;

  // Build iframe in hidden container
  const container = document.getElementById('yt-container');
  const src = _amap[s._srcIdx];
  container.innerHTML = `<iframe src="${src}" allow="autoplay;encrypted-media" allowfullscreen></iframe>`;
  ytIframe = container.querySelector('iframe');

  // Show mini player
  document.getElementById('mini-player').classList.add('visible');
  document.getElementById('mini-icon').textContent = s.icon;
  document.getElementById('mini-title').textContent = s.title;
  document.getElementById('mini-status').textContent = 'Sedang diputar';
  document.getElementById('mini-play').textContent = '⏸';

  // Update waveform in expanded player if visible
  updateExpandedPlayer(sessionId);
  showNotif(`▶ ${s.title} sedang diputar`);
}

function updateExpandedPlayer(sessionId) {
  const cards = document.querySelectorAll('.expanded-player');
  cards.forEach(c => {
    const sid = parseInt(c.dataset.sid);
    const wf = c.querySelector('.waveform');
    const statusEl = c.querySelector('.player-status');
    const playBtn = c.querySelector('.play-btn-sm');
    if (sid === sessionId && isPlaying) {
      if(wf) wf.classList.remove('paused');
      if(statusEl) statusEl.textContent = 'Sedang diputar...';
      if(playBtn) playBtn.textContent = '⏸';
    } else {
      if(wf) wf.classList.add('paused');
      if(statusEl) statusEl.textContent = 'Klik untuk memutar';
      if(playBtn) playBtn.textContent = '▶';
    }
  });
}

function toggleMiniPlay() {
  if (!currentSession) return;
  isPlaying = !isPlaying;
  const btn = document.getElementById('mini-play');
  const status = document.getElementById('mini-status');
  
  if (isPlaying) {
    // Resume: reload iframe
    loadSession(currentSession.id);
  } else {
    // Pause: clear iframe
    const container = document.getElementById('yt-container');
    container.innerHTML = '';
    ytIframe = null;
    btn.textContent = '▶';
    status.textContent = 'Dijeda';
    updateExpandedPlayer(-1);
  }
}

function stopSession() {
  const container = document.getElementById('yt-container');
  container.innerHTML = '';
  ytIframe = null;
  currentSession = null;
  isPlaying = false;
  document.getElementById('mini-player').classList.remove('visible');
  updateExpandedPlayer(-1);
}

function playSession(sessionId) {
  if (currentSession && currentSession.id === sessionId && isPlaying) {
    showNotif('Sesi ini sudah sedang diputar');
    return;
  }
  loadSession(sessionId);
}

// =============================================
// SESSIONS DATA
// =============================================
const SESSIONS = [
  {id:1,_srcIdx:0,icon:'🌊',tag:'Sesi 1',title:'Emotional Regulation & Urge Recovery',desc:'Menenangkan sistem emosi dan mengelola dorongan dengan teknik regulasi berbasis neurosains.',benefit:'Penurunan intensitas dorongan dalam 15–20 menit pertama.',emergency:false},
  {id:2,_srcIdx:1,icon:'🧠',tag:'Sesi 2',title:'Dopamine Reset & Brain Recovery',desc:'Membantu otak kembali ke baseline dopamin alami dan memulihkan kemampuan fokus serta motivasi.',benefit:'Fokus membaik, motivasi kembali muncul, brain fog berkurang.',emergency:false},
  {id:3,_srcIdx:2,icon:'💜',tag:'Sesi 3',title:'Trauma Healing & Emotional Restoration',desc:'Memproses luka emosional dan kesepian yang menjadi akar dari dorongan berulang.',benefit:'Rasa kosong berkurang, koneksi emosional dengan diri sendiri meningkat.',emergency:false},
  {id:4,_srcIdx:3,icon:'🔥',tag:'Sesi 4',title:'Identity Rebuilding & Self-Mastery',desc:'Membangun kembali identitas, kepercayaan diri, dan rasa diri yang kuat melampaui kecanduan.',benefit:'Kepercayaan diri meningkat, kejelasan tentang siapa Anda yang sesungguhnya.',emergency:false},
  {id:5,_srcIdx:4,icon:'✨',tag:'Sesi 5',title:'Releasing Sexual Attachments & Mental Cleansing',desc:'Melepaskan fantasi dan intrusive thoughts melalui teknik mental cleansing berbasis mindfulness.',benefit:'Pikiran lebih jernih, obsesi terhadap konten seksual melemah.',emergency:false},
  {id:6,_srcIdx:5,icon:'🛡',tag:'EMERGENCY',title:'Breaking the Shame Cycle',desc:'Sesi khusus untuk bangkit setelah relapse tanpa tenggelam dalam rasa malu.',benefit:'Rasa malu mereda, motivasi bangkit kembali muncul, siklus self-punishment terhenti.',emergency:true}
];

function renderAudioCard(session, isRecommended=false) {
  const tagCls = session.emergency ? 'em' : '';
  const cardCls = session.emergency ? 'audio-card emergency' : 'audio-card card-accent';
  const isActive = currentSession && currentSession.id === session.id && isPlaying;
  return `
    <div class="${cardCls}">
      <div class="flex items-center gap-12 mb-12">
        <span style="font-size:28px">${session.icon}</span>
        <div style="flex:1">
          <span class="session-tag ${tagCls}">${session.tag}</span>
          <div class="h3">${session.title}</div>
        </div>
      </div>
      <p class="small muted" style="line-height:1.6;margin-bottom:10px">${session.desc}</p>
      <div class="insight-box" style="margin-bottom:12px">
        <div class="label mb-4">Manfaat</div>
        <p class="small">${session.benefit}</p>
      </div>
      ${isRecommended ? '<p class="small muted" style="margin-bottom:10px">Direkomendasikan berdasarkan kondisi Anda saat ini.</p>' : ''}
      <!-- Expanded Player -->
      <div class="player-wrap expanded-player" data-sid="${session.id}">
        <div class="player-controls">
          <button class="play-btn-sm" onclick="playSession(${session.id})">${isActive ? '⏸' : '▶'}</button>
          <div class="player-info">
            <div class="player-title">${session.title}</div>
            <div class="player-status">${isActive ? 'Sedang diputar...' : 'Klik untuk memutar'}</div>
          </div>
          <div class="waveform ${isActive ? '' : 'paused'}">
            <div class="wave-bar" style="height:10px"></div>
            <div class="wave-bar" style="height:16px"></div>
            <div class="wave-bar" style="height:8px"></div>
            <div class="wave-bar" style="height:20px"></div>
            <div class="wave-bar" style="height:12px"></div>
          </div>
        </div>
      </div>
    </div>
  `;
}

function getRecommendedSessions(d) {
  const r = [];
  if (d.urge >= 7) r.push(SESSIONS[0]);
  if (d.feelings.some(f=>['Bosan','Tidak berharga'].includes(f))) r.push(SESSIONS[1]);
  if (d.feelings.some(f=>['Kesepian','Sedih','Kosong','Kecewa'].includes(f))) r.push(SESSIONS[2]);
  if (d.feelings.some(f=>['Tidak berharga','Kecewa'].includes(f))) r.push(SESSIONS[3]);
  if (d.triggers.some(t=>['Konten seksual','Scroll media sosial'].includes(t))) r.push(SESSIONS[4]);
  const seen=new Set(); const u=r.filter(s=>{if(seen.has(s.id))return false;seen.add(s.id);return true});
  if (!u.length) u.push(SESSIONS[0]);
  return u.slice(0,2);
}

// =============================================
// QUOTES
// =============================================
const QUOTES={
  lonely:[{text:"Apa yang Anda butuhkan saat ini mungkin bukan pelarian, tetapi koneksi yang lebih dalam dengan diri sendiri.",attr:"Refleksi Pemulihan"},{text:"Kesepian yang Anda rasakan adalah undangan untuk mengenal diri lebih dalam.",attr:"MentalHelp"}],
  sad:[{text:"Kesedihan Anda valid. Cukup duduk bersamanya, tanpa melarikan diri.",attr:"MentalHelp"},{text:"Malam ini mungkin berat. Tapi Anda sudah melewati malam-malam sebelumnya.",attr:"Recovery Path"}],
  stressed:[{text:"Stres bukan sinyal untuk melarikan diri. Ia adalah sinyal bahwa Anda membutuhkan istirahat yang nyata.",attr:"MentalHelp"},{text:"Satu napas panjang lebih berguna dari satu klik yang akan Anda sesali.",attr:"Recovery Path"}],
  urge_high:[{text:"Dorongan adalah gelombang. Tugas Anda bukan menghentikannya, tetapi membiarkannya berlalu.",attr:"Mindfulness Recovery"},{text:"Setiap kali Anda menolak dorongan, Anda membangun satu lapisan kekuatan yang tidak bisa dicuri.",attr:"MentalHelp"},{text:"Anda lebih dari impuls Anda. Identitas Anda lebih besar dari momen ini.",attr:"Recovery Path"}],
  urge_low:[{text:"Ketenangan yang Anda rasakan hari ini adalah buah dari perjuangan yang tidak terlihat.",attr:"MentalHelp"},{text:"Fondasi pemulihan dibangun di hari-hari seperti ini — tenang, sadar, hadir.",attr:"Recovery Path"}],
  relapse:[{text:"Satu kesalahan tidak menghapus kemajuan yang telah Anda bangun.",attr:"MentalHelp"},{text:"Relapse bukan kegagalan karakter. Ia adalah bagian dari penyakit yang sedang Anda lawan.",attr:"Clinical Psychology"},{text:"Hari ini Anda jatuh. Hari ini juga Anda bangkit. Keduanya terjadi dalam satu hari yang sama.",attr:"Healing Words"}],
  general:[{text:"Pemulihan bukan garis lurus. Ia bergelombang, seperti Anda.",attr:"MentalHelp"},{text:"Anda tidak harus sempurna untuk layak mendapat pemulihan.",attr:"Recovery Companion"},{text:"Yang terpenting bukan seberapa cepat Anda pulih, tetapi bahwa Anda terus berjalan.",attr:"MentalHelp"},{text:"Otak Anda sedang pulih. Beri ia waktu, bukan hukuman.",attr:"Neuroscience of Recovery"}]
};
function getQuote(ctx){
  const f=ctx.feelings||[],u=ctx.urge||5;
  let p=[];
  if(ctx.isRelapse)p=p.concat(QUOTES.relapse);
  if(f.some(x=>['Kesepian','Kosong'].includes(x)))p=p.concat(QUOTES.lonely);
  if(f.some(x=>['Sedih','Kecewa'].includes(x)))p=p.concat(QUOTES.sad);
  if(f.some(x=>['Stres','Frustrasi','Cemas'].includes(x)))p=p.concat(QUOTES.stressed);
  if(u>=7)p=p.concat(QUOTES.urge_high,QUOTES.urge_high);
  if(u<=3)p=p.concat(QUOTES.urge_low);
  if(!p.length)p=QUOTES.general;
  return p[Math.floor(Math.random()*p.length)];
}

// =============================================
// CHECK-IN FLOW
// =============================================
let currentStep=0;
let checkinData={feelings:[],triggers:[],urge:5,needs:[]};
function goCheckin(){resetCheckin();switchTab('checkin')}
function resetCheckin(){
  currentStep=0;checkinData={feelings:[],triggers:[],urge:5,needs:[]};
  document.getElementById('checkin-flow').classList.remove('hidden');
  document.getElementById('checkin-result').classList.add('hidden');
  document.querySelectorAll('.chip').forEach(c=>c.classList.remove('selected'));
  document.getElementById('urge-slider').value=5;
  document.getElementById('urge-val').textContent='5';
  updateStepDisplay();
}
function updateStepDisplay(){
  for(let i=0;i<4;i++){
    const el=document.getElementById(`step-${i}`);
    const dot=document.getElementById(`dot-${i}`);
    if(i===currentStep){el.classList.remove('hidden');el.classList.add('fade-in');dot.classList.add('active');dot.classList.remove('done')}
    else if(i<currentStep){el.classList.add('hidden');dot.classList.remove('active');dot.classList.add('done')}
    else{el.classList.add('hidden');dot.classList.remove('active','done')}
  }
}
function getSelectedChips(id){return Array.from(document.querySelectorAll(`#${id} .chip.selected`)).map(c=>c.dataset.val)}
function nextStep(){
  if(currentStep===0){checkinData.feelings=getSelectedChips('chips-feeling');if(!checkinData.feelings.length){showNotif('Pilih setidaknya satu perasaan');return}}
  if(currentStep===1)checkinData.triggers=getSelectedChips('chips-trigger');
  if(currentStep===2)checkinData.urge=parseInt(document.getElementById('urge-slider').value);
  if(currentStep<3){currentStep++;updateStepDisplay()}
}
function prevStep(){if(currentStep>0){currentStep--;updateStepDisplay()}}
function updateUrge(v){
  document.getElementById('urge-val').textContent=v;
  const el=document.getElementById('urge-context'),n=parseInt(v);
  if(n>=8)el.innerHTML='<div class="label" style="color:var(--danger);margin-bottom:4px">Intensitas Tinggi</div><p class="small">Dorongan yang kuat biasanya berlalu dalam 20 menit. Sesi audio darurat tersedia untuk Anda.</p>';
  else if(n>=5)el.innerHTML='<div class="label" style="color:var(--warn);margin-bottom:4px">Intensitas Sedang</div><p class="small">Anda masih dalam kendali. Satu langkah kecil cukup untuk mengalihkan arah.</p>';
  else el.innerHTML='<div class="label" style="color:var(--success);margin-bottom:4px">Intensitas Rendah</div><p class="small">Ini saat yang tepat untuk check-in dan membangun kesadaran diri.</p>';
}
function submitCheckin(){
  checkinData.needs=getSelectedChips('chips-need');
  const today=new Date().toDateString();
  state.checkins.push({date:today,...checkinData});
  state.totalCheckins++;
  if(state.lastCheckinDate!==today){
    if(state.lastCheckinDate===new Date(Date.now()-86400000).toDateString())state.streak++;
    else if(!state.lastCheckinDate)state.streak=1;
    else state.streak=1;
    state.longestStreak=Math.max(state.longestStreak,state.streak);
    state.lastCheckinDate=today;
  }
  if(!state.streakStart)state.streakStart=today;
  saveState();
  document.getElementById('checkin-flow').classList.add('hidden');
  document.getElementById('checkin-result').classList.remove('hidden');
  document.getElementById('checkin-result').classList.add('fade-in');
  renderResult();refreshHome();refreshProgress();
}
function renderResult(){
  const{feelings,triggers,urge}=checkinData;
  let insight='';
  if(feelings.includes('Kesepian')||feelings.includes('Kosong'))insight='Data Anda menunjukkan bahwa dorongan Anda kemungkinan besar bukan tentang gairah seksual — melainkan kebutuhan koneksi emosional yang tidak terpenuhi.';
  else if(feelings.includes('Stres')||feelings.includes('Cemas')||feelings.includes('Frustrasi'))insight='Pemicu terbesar Anda tampaknya adalah stres dan kelelahan emosional. Otak Anda mencari "reset" cepat melalui dopamin.';
  else if(urge>=8)insight='Dorongan Anda saat ini sangat intens. Ini adalah momen kritis — pilihan yang tepat akan memperkuat koneksi neural pemulihan Anda secara signifikan.';
  else if(feelings.includes('Bosan')||triggers.includes('Tidak ada aktivitas'))insight='Kebosanan dan kekosongan aktivitas adalah kondisi paling rentan. Otak Anda aktif mencari stimulasi.';
  else if(feelings.includes('Tidak berharga')||feelings.includes('Kecewa'))insight='Ketika kita merasa tidak layak, dorongan bisa muncul sebagai bentuk hukuman atau pelarian. Anda tidak perlu menghukum diri — Anda perlu penyembuhan.';
  else insight='Check-in ini adalah langkah penting dalam memahami pola pemulihan Anda.';
  document.getElementById('insight-text').textContent=insight;
  const q=getQuote({feelings,urge});
  document.getElementById('result-quote').innerHTML=`<div class="quote-card"><p>"${q.text}"</p><div class="attr">— ${q.attr}</div></div>`;
  document.getElementById('coach-loading').style.display='block';
  document.getElementById('coach-text').style.display='none';
  setTimeout(()=>{
    const msg=generateCoachMsg(feelings,triggers,urge);
    document.getElementById('coach-loading').style.display='none';
    const ct=document.getElementById('coach-text');ct.textContent=msg;ct.style.display='block';
  },1800);
  const rec=getRecommendedSessions({feelings,triggers,urge});
  document.getElementById('audio-recommendation').innerHTML=rec.map(s=>renderAudioCard(s,true)).join('');
  document.querySelectorAll('#audio-recommendation .play-btn-sm').forEach(btn=>{
    btn.onclick=()=>playSession(parseInt(btn.closest('.expanded-player').dataset.sid));
  });
}
function generateCoachMsg(feelings,triggers,urge){
  const f=feelings[0]||'beragam perasaan';
  let session='Sesi 1: Emotional Regulation',action='jauhi layar selama 15 menit dan lakukan aktivitas fisik ringan';
  if(feelings.includes('Kesepian')||feelings.includes('Kosong')){session='Sesi 3: Trauma Healing';action='hubungi seseorang yang Anda percaya, atau tulis di jurnal tentang apa yang Anda rindukan'}
  else if(feelings.includes('Stres')||feelings.includes('Cemas')){session='Sesi 1: Emotional Regulation';action='lakukan teknik pernapasan 4-7-8: tarik 4 detik, tahan 7, buang 8'}
  else if(feelings.includes('Tidak berharga')||feelings.includes('Kecewa')){session='Sesi 4: Identity Rebuilding';action='tulis satu hal kecil yang Anda lakukan dengan baik hari ini'}
  const note=urge>=7?'Saya tahu dorongan ini terasa sangat kuat.':urge>=4?'Dorongan yang Anda rasakan perlu dikelola sebelum menguat.':'Kondisi Anda relatif stabil saat ini.';
  return `${note} Dari check-in ini, tampaknya rasa ${f} memainkan peran besar dalam kondisi Anda. Ini bukan tentang kemauan yang lemah — ini tentang kebutuhan emosional yang belum terpenuhi. Saya merekomendasikan ${session} untuk Anda. Untuk 15 menit ke depan: ${action}.`;
}

// =============================================
// RELAPSE
// =============================================
let relapseStep=0;
function goRelapse(){relapseStep=0;showRelapseModal()}
function showRelapseModal(){
  const existing=document.getElementById('relapse-overlay');if(existing)existing.remove();
  const ov=document.createElement('div');ov.id='relapse-overlay';ov.className='screen active fade-in';ov.style.paddingBottom='100px';
  ov.innerHTML=`
    <div class="page-header"><p class="label mb-8" style="color:var(--accent2)">Rise After Relapse</p><h1 class="h1">Anda tidak sendirian<br>dalam ini</h1></div>
    <div id="rs-0" class="mt-20">
      <div class="card-accent mb-14">
        <div style="font-size:28px;margin-bottom:12px">🛡</div>
        <div class="relapse-step"><div class="step-num">1</div><div><div class="h3 mb-4">Relapse tidak menghapus kemajuan Anda</div><p class="small muted" style="line-height:1.6">Pemulihan bukan garis lurus. Yang membedakan bukan apakah Anda jatuh — melainkan bagaimana Anda bangkit.</p></div></div>
        <div class="relapse-step"><div class="step-num">2</div><div><div class="h3 mb-4">Rasa malu adalah musuh, bukan guru</div><p class="small muted" style="line-height:1.6">Belas kasih pada diri sendiri adalah fondasi pemulihan yang nyata.</p></div></div>
        <div class="relapse-step"><div class="step-num">3</div><div><div class="h3 mb-4">Momen ini bisa menjadi titik balik</div><p class="small muted" style="line-height:1.6">Jika Anda ada di sini, berarti Anda masih peduli.</p></div></div>
      </div>
      <button class="btn" onclick="relapseNext()">Saya siap berefleksi →</button>
      <button class="btn btn-ghost mt-8" onclick="closeRelapse()">Kembali ke beranda</button>
    </div>
    <div id="rs-1" class="hidden fade-in mt-20">
      <div class="card mb-12">
        <div class="label mb-12">Refleksi Singkat</div>
        <p class="small muted mb-8">Apa yang terjadi sebelum relapse?</p>
        <textarea id="rq1" rows="3" placeholder="Ceritakan situasinya..."></textarea>
        <p class="small muted mt-12 mb-8">Emosi apa yang Anda rasakan?</p>
        <textarea id="rq2" rows="3" placeholder="Apa yang Anda rasakan sebelum dan sesudah?"></textarea>
        <p class="small muted mt-12 mb-8">Apa yang bisa dipelajari?</p>
        <textarea id="rq3" rows="3" placeholder="Pelajaran apa yang bisa diambil?"></textarea>
      </div>
      <button class="btn" onclick="relapseNext()">Lanjut →</button>
      <button class="btn btn-ghost mt-8" onclick="relapsePrev()">← Kembali</button>
    </div>
    <div id="rs-2" class="hidden fade-in mt-20">
      <div class="card-accent mb-12">${renderAudioCard(SESSIONS[5],true)}</div>
      <div class="quote-card"><p>"${getQuote({isRelapse:true}).text}"</p><div class="attr">— MentalHelp</div></div>
      <div class="coach-bubble"><p class="small" style="line-height:1.7">Apa yang baru Anda alami adalah bagian dari perjalanan — bukan bukti bahwa Anda tidak bisa berubah. Otak dalam proses pemulihan akan mencoba kembali ke pola lama. Itu bukan kelemahan karakter — itu neurobiologi. <strong style="color:var(--text)">Langkah pertama Anda:</strong> dengarkan Emergency Session selama 10 menit. Streak baru dimulai dari detik ini.</p></div>
      <button class="btn" onclick="completeRelapse()">Saya siap bangkit kembali ✦</button>
      <button class="btn btn-ghost mt-8" onclick="closeRelapse()">Kembali ke beranda</button>
    </div>
  `;
  document.getElementById('app').appendChild(ov);
  document.querySelectorAll('.screen').forEach(s=>{if(s!==ov)s.classList.remove('active')});
  ov.querySelectorAll('.play-btn-sm').forEach(btn=>{
    btn.onclick=()=>playSession(parseInt(btn.closest('.expanded-player').dataset.sid));
  });
}
function relapseNext(){relapseStep++;for(let i=0;i<3;i++){const el=document.getElementById(`rs-${i}`);if(el)el.classList.toggle('hidden',i!==relapseStep)}}
function relapsePrev(){relapseStep--;for(let i=0;i<3;i++){const el=document.getElementById(`rs-${i}`);if(el)el.classList.toggle('hidden',i!==relapseStep)}}
function completeRelapse(){state.streak=0;state.streakStart=new Date().toDateString();state.relapses=(state.relapses||0)+1;saveState();closeRelapse();refreshHome();showNotif('Streak dimulai kembali. Anda sudah mengambil langkah terpenting: bangkit.')}
function closeRelapse(){const ov=document.getElementById('relapse-overlay');if(ov)ov.remove();switchTab('home')}

// =============================================
// HOME
// =============================================
function refreshHome(){
  const h=new Date().getHours();
  document.getElementById('greeting-text').textContent=h<12?'Selamat pagi':h<17?'Selamat siang':h<21?'Selamat sore':'Selamat malam';
  const days=state.streak;
  document.getElementById('streak-days').textContent=days;
  document.getElementById('streak-circle').style.setProperty('--p',`${Math.min(days/90*100,100)}%`);
  let msg=days===0?'Hari ini adalah hari pertama yang baru.':days===1?'Satu hari dijalani. Satu langkah nyata.':days<7?`${days} hari dijalani. Fondasi sedang dibangun.`:days<30?`${days} hari! Otak Anda aktif membentuk pola baru.`:`${days} hari yang luar biasa.`;
  document.getElementById('streak-msg').textContent=msg;
  document.getElementById('streak-badge').textContent=days>=30?'🔥 Momentum kuat':days>=7?'✦ Berkembang':'🌱 Dimulai';
  const week=state.checkins.slice(-7);
  document.getElementById('stat-checkins').textContent=week.length;
  const avgU=week.length?(week.reduce((a,c)=>a+c.urge,0)/week.length).toFixed(1):'—';
  document.getElementById('stat-avg-urge').textContent=avgU;
  const allT=state.checkins.flatMap(c=>c.triggers);
  const tc={};allT.forEach(t=>{tc[t]=(tc[t]||0)+1});
  const top=Object.entries(tc).sort((a,b)=>b[1]-a[1])[0];
  document.getElementById('stat-top-trigger').textContent=top?top[0].split(' ')[0]:'—';
  const avgF=week.length?week.reduce((a,c)=>a+(10-c.urge),0)/week.length*10:null;
  document.getElementById('stat-stability').textContent=avgF?Math.round(avgF)+'%':'—';
  const days2=['Min','Sen','Sel','Rab','Kam','Jum','Sab'];
  const last7=[];
  for(let i=6;i>=0;i--){const d=new Date(Date.now()-i*86400000).toDateString();const e=state.checkins.filter(c=>c.date===d);const a=e.length?e.reduce((s,c)=>s+c.urge,0)/e.length:0;last7.push({day:days2[new Date(Date.now()-i*86400000).getDay()],val:a})}
  const mx=Math.max(...last7.map(d=>d.val),1);
  document.getElementById('urge-chart').innerHTML=last7.map(d=>`<div class="bar-col"><div class="bar ${d.val>=7?'high':d.val>0&&d.val<=4?'low':''}" style="height:${d.val?Math.round(d.val/mx*60):4}px"></div><div class="bar-label">${d.day}</div></div>`).join('');
  const tb=document.getElementById('trend-badge');
  if(week.length<2){tb.textContent='Data terbatas';tb.className='badge badge-purple'}
  else{const half=Math.floor(week.length/2);const rec=week.slice(half).reduce((a,c)=>a+c.urge,0)/(week.length-half);const old=week.slice(0,half).reduce((a,c)=>a+c.urge,0)/half;if(rec<old){tb.textContent='↘ Membaik';tb.className='badge badge-green'}else if(rec>old){tb.textContent='↗ Meningkat';tb.className='badge badge-danger'}else{tb.textContent='→ Stabil';tb.className='badge badge-warn'}}
  const ctx=state.checkins.length?state.checkins[state.checkins.length-1]:{};
  const q=getQuote({feelings:ctx.feelings||[],urge:ctx.urge||5});
  document.getElementById('home-quote').innerHTML=`<div class="quote-card"><p>"${q.text}"</p><div class="attr">— ${q.attr}</div></div>`;
}

function refreshProgress(){
  document.getElementById('prog-streak').textContent=state.streak;
  document.getElementById('prog-total').textContent=state.totalCheckins;
  document.getElementById('prog-longest').textContent=state.longestStreak;
  const all=state.checkins;
  const now=new Date();
  const month=all.filter(c=>(now-new Date(c.date))<30*86400000);
  const prev=all.filter(c=>{const d=now-new Date(c.date);return d>=30*86400000&&d<60*86400000});
  let growth='—';
  if(prev.length&&month.length){const g=((month.length-prev.length)/prev.length*100).toFixed(0);growth=(g>0?'+':'')+g+'%'}
  document.getElementById('prog-growth').textContent=growth;
  const r7=all.slice(-7);
  if(r7.length){const sc=Math.round(r7.reduce((a,c)=>a+(10-c.urge),0)/r7.length*10);document.getElementById('stability-arc').style.strokeDashoffset=213.6-(213.6*sc/100);document.getElementById('stability-pct').textContent=sc+'%';document.getElementById('stability-desc').textContent=sc>=70?'Stabilitas emosi Anda baik. Pertahankan ritme ini.':sc>=40?'Ada ruang untuk berkembang. Sesi audio dapat membantu.':'Fokus pada emotional regulation sekarang.'}
  const allT=all.flatMap(c=>c.triggers);
  if(allT.length){const counts={};allT.forEach(t=>{counts[t]=(counts[t]||0)+1});const sorted=Object.entries(counts).sort((a,b)=>b[1]-a[1]).slice(0,4);const mx=sorted[0][1];document.getElementById('trigger-analysis').innerHTML=`<div class="label mb-12">Pemicu Paling Sering</div>${sorted.map(([k,v])=>`<div style="margin-bottom:10px"><div class="flex justify-between items-center mb-4"><span class="small">${k}</span><span class="small muted">${v}x</span></div><div style="height:4px;background:var(--border);border-radius:2px"><div style="height:4px;background:var(--accent);border-radius:2px;width:${Math.round(v/mx*100)}%;transition:width .6s"></div></div></div>`).join('')}`}
  const data14=[];
  for(let i=13;i>=0;i--){const d=new Date(Date.now()-i*86400000).toDateString();const e=all.filter(c=>c.date===d);data14.push(e.length?e.reduce((a,c)=>a+c.urge,0)/e.length:0)}
  const mx14=Math.max(...data14,1);
  document.getElementById('progress-chart').innerHTML=data14.map(v=>`<div class="bar-col"><div class="bar ${v>=7?'high':v>0&&v<=4?'low':''}" style="height:${v?Math.round(v/mx14*60):4}px"></div></div>`).join('');
}

function renderAudioLibrary(){
  const c=document.getElementById('audio-cards');
  c.innerHTML=SESSIONS.map(s=>renderAudioCard(s,false)).join('');
  c.querySelectorAll('.play-btn-sm').forEach(btn=>{
    btn.onclick=()=>playSession(parseInt(btn.closest('.expanded-player').dataset.sid));
  });
}

// =============================================
// NAV
// =============================================
function switchTab(tab){
  const rl=document.getElementById('relapse-overlay');if(rl)rl.remove();
  document.querySelectorAll('.screen').forEach(s=>s.classList.remove('active'));
  document.querySelectorAll('.nav-btn').forEach(b=>b.classList.remove('active'));
  document.getElementById(`screen-${tab}`).classList.add('active');
  document.getElementById(`nav-${tab}`).classList.add('active');
  if(tab==='home')refreshHome();
  if(tab==='progress')refreshProgress();
  if(tab==='audio')renderAudioLibrary();
}

function showNotif(msg){const el=document.getElementById('notif');el.textContent=msg;el.classList.add('show');setTimeout(()=>el.classList.remove('show'),3000)}
function confirmReset(){if(confirm('Reset semua data pemulihan?')){state={streak:0,streakStart:null,longestStreak:0,totalCheckins:0,checkins:[],lastCheckinDate:null,relapses:0};saveState();refreshHome();refreshProgress();showNotif('Data direset. Perjalanan baru dimulai.')}}

// CHIP SELECTION
document.querySelectorAll('.chip').forEach(chip=>{chip.addEventListener('click',()=>chip.classList.toggle('selected'))});

// ONBOARDING
function startApp(){document.getElementById('onboard').classList.add('hidden');document.getElementById('main-app').classList.remove('hidden');document.getElementById('main-nav').classList.remove('hidden');localStorage.setItem('mh_rc_seen','1');refreshHome()}

window.addEventListener('DOMContentLoaded',()=>{
  updateUrge(5);
  if(localStorage.getItem('mh_rc_seen'))startApp();
  else document.getElementById('onboard').classList.remove('hidden');
});
</script>
